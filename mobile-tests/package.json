{
  "name": "toolshop-mobile-tests",
  "version": "1.0.0",
  "description": "Testes automatizados do app mobile Toolshop (Android e iOS) com Appium + WebdriverIO + Mocha + Allure",
  "scripts": {
    "apps:download": "./scripts/download-apps.sh",
    "appium:drivers": "APPIUM_HOME=.appium appium driver install uiautomator2 && APPIUM_HOME=.appium appium driver install xcuitest",
    "appium:doctor": "APPIUM_HOME=.appium appium driver doctor uiautomator2 && APPIUM_HOME=.appium appium driver doctor xcuitest",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:ios": "wdio run config/wdio.ios.conf.ts",
    "test": "./scripts/test-all.sh",
    "report": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "test:browserstack:android": "wdio run config/wdio.browserstack.android.conf.ts",
    "allure:generate": "tsx scripts/allure-report.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/allure-reporter": "^10.1.0",
    "@wdio/appium-service": "^10.1.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "dotenv": "^18.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webdriverio": "^10.1.0"
  },
  "private": true
}
